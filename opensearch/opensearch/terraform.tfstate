uest-agent\n  - net-tools\n  - zabbix-agent2\n\nchpasswd:\n  list: |\n    ubadmin:$6$OUhtkqzqgFbDTAlK$5mtVFPiuYlzwC7kuM4MKjfGqdANTzxKU.zigqjVuc/ZkEdS9d87tXjTllHaofIf1fIBvUcLNbKVF.k0L.9Jh10\n  expire: false\ngroups:\n  - admins\nusers:\n  - name: ubadmin\n    primary_group: admins\n    groups:\n      - sudo\n      - admins\n    groups: sudo\n    shell: /bin/bash\n    ssh-authorized-keys:\n      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIDPn58v3fu9JFIYpNVeZWB6AiJWKFFjAWF3Kdnttfq+a medik@DESKTOP-OOTERBI\n    sudo: ALL=(ALL) NOPASSWD:ALL\n\ndevice_aliases: {data_disk: /dev/sdb}\ndisk_setup:\n  data_disk:\n    layout: [100]\n    overwrite: true\n    table_type: gpt\nfs_setup:\n  - {cmd: mkfs -t %(filesystem)s -L %(label)s %(device)s, device: data_disk.1, filesystem: ext4,\n  label: data}\nmounts:\n  - [data_disk.1, /mnt/data]\n\n\nwrite_files:\n  - path: /etc/ssh/sshd_config.d/60-cloudimg-settings.conf\n    permissions: 0640\n    owner: root:root\n    content: |\n      Port 22\n      PermitRootLogin no\n      PasswordAuthentication no\n      ClientAliveInterval 5m\n      ClientAliveCountMax 3\n      AllowGroups admins\n\n      \nruncmd:\n    - sudo sed -i 's/^Server=.*$/Server=10.20.15.42/' /etc/zabbix/zabbix_agent2.conf\n    - timedatectl set-timezone Europe/Moscow\n    - systemctl enable qemu-guest-agent fail2ban\n    - systemctl start qemu-guest-agent\n    - echo \"done\" \u003e /tmp/cloud-config.done\n    \npower_state:\n    delay: now\n    mode: reboot\n    message: Rebooting after cloud-init completion\n    condition: true\n\n","file_name":"opensearch-1.cloud-config.yaml","resize":0}],"timeout_upload":1800},"sensitive_attributes":[[{"type":"get_attr","value":"source_raw"},{"type":"index","value":{"value":0,"type":"number"}},{"type":"get_attr","value":"data"}]],"private":"bnVsbA==","dependencies":["data.local_file.ssh_public_key"]},{"index_key":1,"schema_version":0,"attributes":{"content_type":"snippets","datastore_id":"local","file_mode":null,"file_modification_date":n